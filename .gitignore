# ==========================================
# Comprehensive .gitignore for Angular & .NET
# ==========================================

# ------------------------------------------
# Node.js & Angular Build Artifacts
# ------------------------------------------
node_modules/
client/node_modules/
client/dist/
client/.angular/
client/.sass-cache/
client/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
client/package-lock.json

# ------------------------------------------
# .NET / C# Build Artifacts
# ------------------------------------------
bin/
obj/
server/**/bin/
server/**/obj/
server/.vs/
server/*.user
server/*.userosscache
server/*.sln.docstates
[Dd]ebug/
[Rr]elease/
*.suo
*.user
*.userhost
*.sln.docstates

# ------------------------------------------
# Operating System & IDE Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.swp
*.swo

# ------------------------------------------
# Environment & Secret Files
# ------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.pfx

# ------------------------------------------
# Logs & Temporary Files
# ------------------------------------------
*.log
logs/
temp/
tmp/
