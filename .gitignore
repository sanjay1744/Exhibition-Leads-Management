# ==========================================
# Comprehensive .gitignore for Angular & .NET
# ==========================================

# ------------------------------------------
# Node.js & Frontend Build Artifacts
# ------------------------------------------
**/node_modules/
**/dist/
**/.angular/
**/.sass-cache/
**/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# ------------------------------------------
# .NET / C# Build Artifacts
# ------------------------------------------
**/bin/
**/obj/
**/.vs/
*.user
*.userosscache
*.sln.docstates
[Dd]ebug/
[Rr]elease/
*.suo
*.userhost

# ------------------------------------------
# Environment & Secret Configuration Files
# ------------------------------------------
**/appsettings.json
**/appsettings.Development.json
**/appsettings.*.json
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.pfx

# ------------------------------------------
# Operating System & IDE Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.swp
*.swo

# ------------------------------------------
# Logs & Temporary Files
# ------------------------------------------
*.log
logs/
temp/
tmp/

# ------------------------------------------
# Uploads & Media Files
# ------------------------------------------
**/wwwroot/uploads/
**/uploads/card_images/

